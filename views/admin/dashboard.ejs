<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PharmaSeek — Admin Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

  <div class="layout">

    <!-- ── SIDEBAR ─────────────────────────────────── -->
    <%- include('../partials/sidebar', { active: 'dashboard' }) %>

    <!-- ── MAIN ────────────────────────────────────── -->
    <main class="main">

      <div class="topbar">
        <div>
          <h1>Dashboard</h1>
          <p>Overview of system activity and inventory health</p>
        </div>
        <div class="topbar__actions">
          <button class="bell" title="Notifications">
            <i data-lucide="bell" class="ic"></i>
            <span class="dot"></span>
          </button>
        </div>
      </div>

      <hr class="divider">

      <!-- ── STAT CARDS ─────────────────────────────── -->
      <section class="stats stats--2">
        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--blue"><i data-lucide="users" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Active Users</div>
            <div class="stat-card__value"><%= stats.activeUsers %></div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--green"><i data-lucide="wallet" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Sales Revenue (This Month)</div>
            <div class="stat-card__value">₱<%= Number(stats.revenue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
          </div>
        </div>
      </section>

      <!-- ── RECENT TRANSACTIONS ────────────────────── -->
      <section class="panel">
        <div class="panel__header">
          <h2>Recent Transactions</h2>
        </div>

        <div class="table-wrap">
          <table class="tx-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Medicine Name</th>
                <th>Type</th>
                <th>Quantity Added</th>
                <th>Quantity Removed</th>
                <th>Remaining Stock</th>
                <th>Recorded By</th>
              </tr>
            </thead>
            <tbody>
              <% if (transactions.length === 0) { %>
                <tr class="empty-row">
                  <td colspan="7">No transactions recorded yet.</td>
                </tr>
              <% } else { %>
                <% transactions.forEach(function(tx, i) { %>
                  <% const isRestock = tx.transaction_type === 'restock'; %>
                  <% const initials = tx.first_name[0] + tx.last_name[0]; %>
                  <% const colorIndex = (tx.first_name.charCodeAt(0) + tx.last_name.charCodeAt(0)) % 5; %>
                  <tr>
                    <td><%= new Date(tx.transaction_date).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila' }) %></td>
                    <td class="medicine-name"><%= tx.medicine_name %></td>
                    <td>
                      <span class="badge badge--<%= tx.transaction_type %>"><%= tx.transaction_type.toUpperCase() %></span>
                    </td>
                    <td class="qty-pos"><%= isRestock ? tx.transaction_quantity : 0 %></td>
                    <td class="qty-neg"><%= isRestock ? 0 : tx.transaction_quantity %></td>
                    <td><%= tx.stock_quantity %></td>
                    <td>
                      <div class="tx-user">
                        <div class="avatar avatar--<%= colorIndex %>"><%= initials %></div>
                        <%= tx.first_name %> <%= tx.last_name %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>

        <a href="/admin/reports"><button class="btn-primary btn-primary--below-table">View Full Reports <i data-lucide="arrow-right" class="ic"></i></button></a>
      </section>


      <p class="page-footer">
        &copy; <%= new Date().getFullYear() %> PharmaSeek Inventory Management System. IM2.
      </p>

    </main>
  </div>

  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>lucide.createIcons();</script>
  <script src="/js/notifications.js"></script>
</body>
</html>
