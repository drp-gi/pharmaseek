<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PharmaSeek — Staff Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/inventory.css">
</head>
<body>

  <div class="layout">

    <!-- ── SIDEBAR ─────────────────────────────────── -->
    <%- include('../partials/staff-sidebar', { active: 'dashboard' }) %>

    <!-- ── MAIN ────────────────────────────────────── -->
    <main class="main">

      <div class="topbar">
        <div>
          <h1>Dashboard</h1>
          <p>Overview of current inventory alerts</p>
        </div>
        <div class="topbar__actions">
          <button class="bell" title="Notifications">
            <i data-lucide="bell" class="ic"></i>
            <span class="dot"></span>
          </button>
        </div>
      </div>

      <hr class="divider">

      <% if (error) { %>
        <div class="alert alert--error">
          <i data-lucide="circle-alert" class="ic"></i>
          <%= error %>
        </div>
      <% } %>

      <!-- ── STAT CARDS ─────────────────────────────── -->
      <section class="stats stats--4">
        <div class="stat-card stat-card--danger">
          <div class="stat-card__icon stat-card__icon--red"><i data-lucide="ban" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Out of Stock</div>
            <div class="stat-card__value"><%= stats.outOfStock %></div>
          </div>
        </div>

        <div class="stat-card stat-card--warn">
          <div class="stat-card__icon stat-card__icon--amber"><i data-lucide="triangle-alert" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Low Stock</div>
            <div class="stat-card__value"><%= stats.lowStock %></div>
          </div>
        </div>

        <div class="stat-card stat-card--danger">
          <div class="stat-card__icon stat-card__icon--red"><i data-lucide="calendar-x" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Expired</div>
            <div class="stat-card__value"><%= stats.expired %></div>
          </div>
        </div>

        <div class="stat-card stat-card--warn">
          <div class="stat-card__icon stat-card__icon--amber"><i data-lucide="calendar-clock" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Expiring Soon</div>
            <div class="stat-card__value"><%= stats.expiringSoon %></div>
          </div>
        </div>
      </section>

      <!-- ── STOCK + EXPIRATION ALERTS ────────────────── -->
      <section class="bottom-grid">
        <div class="panel">
          <div class="panel__header">
            <h2>Stock Alerts</h2>
          </div>

          <div class="table-wrap">
            <table class="tx-table">
              <thead>
                <tr>
                  <th>Medicine</th>
                  <th>Category</th>
                  <th>Current Stock</th>
                  <th>Threshold</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (stockAlertItems.length === 0) { %>
                  <tr class="empty-row"><td colspan="5">No medicines are below their stock threshold.</td></tr>
                <% } else { %>
                  <% stockAlertItems.forEach(function(m) { %>
                    <% const outOfStock = Number(m.stock_quantity) === 0; %>
                    <tr>
                      <td class="medicine-name"><%= m.medicine_name %></td>
                      <td><%= m.category_name || '—' %></td>
                      <td class="text-low-stock"><%= Number(m.stock_quantity).toLocaleString() %> units</td>
                      <td><%= Number(m.stock_threshold).toLocaleString() %> units</td>
                      <td>
                        <% if (outOfStock) { %>
                          <span class="badge badge--out-of-stock">Out of Stock</span>
                        <% } else { %>
                          <span class="badge badge--low-stock">Low Stock</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>

          <a href="/staff/inventory"><button class="btn-primary btn-primary--below-table">View Full Inventory <i data-lucide="arrow-right" class="ic"></i></button></a>
        </div>

        <div class="panel">
          <div class="panel__header">
            <h2>Expiration Alerts</h2>
          </div>

          <div class="table-wrap">
            <table class="tx-table">
              <thead>
                <tr>
                  <th>Medicine</th>
                  <th>Category</th>
                  <th>Expiration Date</th>
                  <th>Days Left</th>
                </tr>
              </thead>
              <tbody>
                <% if (expiryAlertItems.length === 0) { %>
                  <tr class="empty-row"><td colspan="4">No medicines are expired or expiring within 30 days.</td></tr>
                <% } else { %>
                  <% expiryAlertItems.forEach(function(m) { %>
                    <tr>
                      <td class="medicine-name"><%= m.medicine_name %></td>
                      <td><%= m.category_name || '—' %></td>
                      <td><%= new Date(m.expiration_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Manila' }) %></td>
                      <td>
                        <% if (m.daysLeft < 0) { %>
                          <span class="badge badge--expired">Expired <%= Math.abs(m.daysLeft) %> day<%= Math.abs(m.daysLeft) === 1 ? '' : 's' %> ago</span>
                        <% } else { %>
                          <span class="<%= m.daysLeft <= 7 ? 'text-low-stock' : '' %>">
                            <%= m.daysLeft %> day<%= m.daysLeft === 1 ? '' : 's' %>
                          </span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ── RECENT TRANSACTIONS ────────────────────── -->
      <section class="panel">
        <div class="panel__header">
          <h2>Recent Transactions</h2>
        </div>

        <div class="table-wrap">
          <table class="tx-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Medicine Name</th>
                <th>Type</th>
                <th>Quantity</th>
                <th>Recorded By</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentTransactions.length === 0) { %>
                <tr class="empty-row">
                  <td colspan="5">No transactions recorded yet.</td>
                </tr>
              <% } else { %>
                <% recentTransactions.forEach(function(tx) { %>
                  <% const isRestock = tx.transaction_type === 'restock'; %>
                  <% const initials = tx.first_name[0] + tx.last_name[0]; %>
                  <% const colorIndex = (tx.first_name.charCodeAt(0) + tx.last_name.charCodeAt(0)) % 5; %>
                  <tr>
                    <td><%= new Date(tx.transaction_date).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila' }) %></td>
                    <td class="medicine-name"><%= tx.medicine_name %></td>
                    <td>
                      <span class="badge badge--<%= tx.transaction_type %>"><%= tx.transaction_type.toUpperCase() %></span>
                    </td>
                    <td class="<%= isRestock ? 'qty-pos' : 'qty-neg' %>">
                      <%= isRestock ? '+' : '-' %><%= tx.transaction_quantity %> Units
                    </td>
                    <td>
                      <div class="tx-user">
                        <div class="avatar avatar--<%= colorIndex %>"><%= initials %></div>
                        <%= tx.first_name %> <%= tx.last_name %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>

        <a href="/staff/transactions?tab=history"><button class="btn-primary btn-primary--below-table">View All Transactions <i data-lucide="arrow-right" class="ic"></i></button></a>
      </section>

      <!-- ── QUICK ACTIONS ─────────────────────────────── -->
      <div class="staff-actions">
        <a href="/staff/inventory"><button class="btn-primary"><i data-lucide="package" class="ic"></i> View Inventory</button></a>
        <a href="/staff/transactions?tab=sale"><button class="btn-outline"><i data-lucide="circle-plus" class="ic"></i> Record a Transaction</button></a>
      </div>

      <!-- ── APPROVED RESTOCK BANNER ───────────────────── -->
      <% if (approvedAwaitingDelivery > 0) { %>
        <div class="notice-banner">
          <div class="notice-banner__icon"><i data-lucide="truck" class="ic"></i></div>
          <div class="notice-banner__text">
            <%= approvedAwaitingDelivery %> restock <%= approvedAwaitingDelivery === 1 ? 'delivery' : 'deliveries' %> expected. Check in when <%= approvedAwaitingDelivery === 1 ? 'it arrives' : 'they arrive' %>.
          </div>
          <a href="/staff/transactions?tab=delivery" class="notice-banner__link">Delivery Check-in <i data-lucide="chevron-right" class="ic"></i></a>
        </div>
      <% } %>

      <hr class="divider">

      <p class="info-line">
        <i data-lucide="info" class="ic"></i>
        You've recorded <%= transactionsToday %> transaction<%= transactionsToday === 1 ? '' : 's' %> today
      </p>

    </main>
  </div>

  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>lucide.createIcons();</script>
  <script src="/js/notifications.js"></script>
</body>
</html>
