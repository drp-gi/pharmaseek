<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PharmaSeek — Transactions</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/users.css">
  <link rel="stylesheet" href="/css/reports.css">
  <link rel="stylesheet" href="/css/transactions.css">
</head>
<body>

  <div class="layout">

    <!-- ── SIDEBAR ─────────────────────────────────── -->
    <%- include('../partials/staff-sidebar', { active: 'transactions' }) %>

    <!-- ── MAIN ────────────────────────────────────── -->
    <main class="main">

      <div class="topbar">
        <div>
          <h1>Transactions</h1>
          <p>Record sales, disposals, and deliveries</p>
        </div>
        <div class="topbar__actions">
          <button class="bell" title="Notifications">
            <i data-lucide="bell" class="ic"></i>
            <span class="dot"></span>
          </button>
        </div>
      </div>

      <hr class="divider">

      <% if (error) { %>
        <div class="alert alert--error" id="pageErrorAlert">
          <i data-lucide="circle-alert" class="ic"></i>
          <%= error %>
        </div>
      <% } %>

      <!-- ── TABS ─────────────────────────────────────── -->
      <div class="report-tabs">
        <a href="/staff/transactions?tab=sale" class="report-tab <%= tab === 'sale' ? 'active' : '' %>">Sale</a>
        <a href="/staff/transactions?tab=disposal" class="report-tab <%= tab === 'disposal' ? 'active' : '' %>">Disposal</a>
        <a href="/staff/transactions?tab=delivery" class="report-tab <%= tab === 'delivery' ? 'active' : '' %>">Delivery Check-in</a>
      </div>

      <% if (tab === 'sale') { %>
        <!-- ── NEW SALE ENTRY (cart) ─────────────────────── -->
        <section class="panel">
          <div class="panel__header"><h2>New Sale Entry</h2></div>
          <div class="filter-row">
            <div class="filter-field medicine-search-field">
              <label for="sale_medicine_search">Search Medicine</label>
              <div class="search">
                <i data-lucide="search" class="ic"></i>
                <input type="text" id="sale_medicine_search" placeholder="Type medicine name..." autocomplete="off">
              </div>
              <div class="medicine-suggestions" id="saleMedicineSuggestions"></div>
            </div>
            <div class="filter-field">
              <label for="sale_quantity">Quantity</label>
              <input type="number" id="sale_quantity" min="1" placeholder="Enter quantity">
            </div>
            <div class="filter-row__spacer"></div>
            <button type="button" class="btn-primary" id="saleAddToCartBtn">
              <i data-lucide="plus" class="ic"></i> Add to List
            </button>
          </div>
          <p class="cart-add-error alert alert--error" id="saleCartAddError" style="display:none;"></p>

          <!-- ── ITEMS TO RECORD ────────────────────────── -->
          <div class="cart-section" id="saleCartSection" style="display:none;">
            <h3 class="cart-section__title">Items to Record</h3>
            <div class="table-wrap">
              <table class="tx-table">
                <thead>
                  <tr>
                    <th>Medicine</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="saleCartBody"></tbody>
              </table>
            </div>
            <div class="cart-total">
              <span>Total</span>
              <span class="cart-total__value" id="saleCartTotal">₱0.00</span>
            </div>
            <p class="alert alert--error" id="saleCartSubmitError" style="display:none;"></p>
            <button type="button" class="btn-primary" id="saleRecordBtn">Record Sale</button>
          </div>
        </section>

        <script id="saleMedicinesData" type="application/json"><%- JSON.stringify(medicines).replace(/</g, '\\u003c') %></script>

        <!-- ── TODAY'S SALES ────────────────────────────── -->
        <section class="panel">
          <div class="panel__header"><h2>Today's Sales</h2></div>
          <div class="tx-list">
            <% if (todaysEntries.length === 0) { %>
              <p class="empty-catalog">No sales recorded today.</p>
            <% } else { %>
              <% todaysEntries.forEach(function(t) { %>
                <div class="tx-list__row">
                  <div>
                    <div class="tx-list__name"><%= t.medicine_name %></div>
                    <div class="tx-list__meta">Qty: <%= t.transaction_quantity %> unit<%= t.transaction_quantity === 1 ? '' : 's' %></div>
                  </div>
                  <div class="tx-list__right">
                    <div class="tx-list__time"><%= new Date(t.transaction_date).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Manila' }) %></div>
                    <div class="tx-list__amount">₱<%= (t.transaction_quantity * t.unit_price).toFixed(2) %></div>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </section>

      <% } else if (tab === 'disposal') { %>
        <!-- ── NEW DISPOSAL ENTRY (cart) ─────────────────── -->
        <section class="panel">
          <div class="panel__header"><h2>New Disposal Entry</h2></div>
          <div class="filter-row">
            <div class="filter-field medicine-search-field">
              <label for="disposal_medicine_search">Search Medicine</label>
              <div class="search">
                <i data-lucide="search" class="ic"></i>
                <input type="text" id="disposal_medicine_search" placeholder="Type medicine name..." autocomplete="off">
              </div>
              <div class="medicine-suggestions" id="disposalMedicineSuggestions"></div>
            </div>
            <div class="filter-field">
              <label for="disposal_quantity">Quantity</label>
              <input type="number" id="disposal_quantity" min="1" placeholder="Enter quantity">
            </div>
            <div class="filter-row__spacer"></div>
            <button type="button" class="btn-primary" id="disposalAddToCartBtn">
              <i data-lucide="plus" class="ic"></i> Add to List
            </button>
          </div>
          <p class="cart-add-error alert alert--error" id="disposalCartAddError" style="display:none;"></p>

          <!-- ── ITEMS TO RECORD ────────────────────────── -->
          <div class="cart-section" id="disposalCartSection" style="display:none;">
            <h3 class="cart-section__title">Items to Record</h3>
            <div class="table-wrap">
              <table class="tx-table">
                <thead>
                  <tr>
                    <th>Medicine</th>
                    <th>Quantity</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="disposalCartBody"></tbody>
              </table>
            </div>

            <div class="filter-field cart-reason-field">
              <label for="disposal_reason">Reason (applies to all items above)</label>
              <input type="text" id="disposal_reason" placeholder="e.g. Damaged packaging, expired stock">
            </div>

            <p class="alert alert--error" id="disposalCartSubmitError" style="display:none;"></p>
            <button type="button" class="btn-primary" id="disposalRecordBtn">Record Disposal</button>
          </div>
        </section>

        <script id="disposalMedicinesData" type="application/json"><%- JSON.stringify(medicines).replace(/</g, '\\u003c') %></script>

        <!-- ── TODAY'S DISPOSALS ────────────────────────── -->
        <section class="panel">
          <div class="panel__header"><h2>Today's Disposals</h2></div>
          <div class="tx-list">
            <% if (todaysEntries.length === 0) { %>
              <p class="empty-catalog">No disposals recorded today.</p>
            <% } else { %>
              <% todaysEntries.forEach(function(t) { %>
                <div class="tx-list__row">
                  <div>
                    <div class="tx-list__name"><%= t.medicine_name %></div>
                    <div class="tx-list__meta">Qty: <%= t.transaction_quantity %> unit<%= t.transaction_quantity === 1 ? '' : 's' %> — <%= t.disposal_reason %></div>
                  </div>
                  <div class="tx-list__right">
                    <div class="tx-list__time"><%= new Date(t.transaction_date).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Manila' }) %></div>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </section>

      <% } else { %>
        <!-- ── DELIVERY CHECK-IN ─────────────────────────── -->
        <section class="panel">
          <div class="panel__header"><h2>Approved Deliveries</h2></div>
          <div class="table-wrap">
            <table class="tx-table">
              <thead>
                <tr>
                  <th>Medicine</th>
                  <th>Quantity</th>
                  <th>Approved Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (approvedDeliveries.length === 0) { %>
                  <tr class="empty-row"><td colspan="4">No deliveries awaiting check-in.</td></tr>
                <% } else { %>
                  <% approvedDeliveries.forEach(function(r) { %>
                    <tr>
                      <td class="medicine-name"><%= r.medicine_name %></td>
                      <td><%= Number(r.quantity_requested).toLocaleString() %> units</td>
                      <td><%= new Date(r.request_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Manila' }) %></td>
                      <td>
                        <button type="button" class="btn-checkin"
                                data-confirm-delivery-trigger
                                data-request-id="<%= r.request_id %>"
                                data-medicine="<%= r.medicine_name %>"
                                data-requested-qty="<%= Number(r.quantity_requested).toLocaleString() %> units">
                          <i data-lucide="package-check" class="ic"></i> Confirm Delivery
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>

      <p class="page-footer">
        &copy; <%= new Date().getFullYear() %> PharmaSeek Management Systems. All rights reserved.
      </p>

    </main>
  </div>

  <!-- ── CONFIRM DELIVERY MODAL ────────────────────── -->
  <div class="modal-overlay" id="confirmDeliveryOverlay">
    <div class="modal modal--sm">
      <div class="modal__header">
        <h3 id="confirmDeliveryTitle">Confirm Delivery</h3>
        <button class="modal__close" id="closeConfirmDelivery" type="button">
          <i data-lucide="x" class="ic"></i>
        </button>
      </div>

      <form id="confirmDeliveryForm" action="" method="POST" class="confirm-modal__body">
        <div class="modal-details-box">
          <div class="modal-detail">
            <span class="modal-detail__label">Requested Quantity</span>
            <span class="modal-detail__value" id="confirmDeliveryRequestedQty"></span>
          </div>
        </div>

        <div class="field">
          <label for="quantity_received">Quantity Actually Received</label>
          <input type="number" id="quantity_received" name="quantity_received" min="1" placeholder="0" required>
        </div>

        <div class="field">
          <label for="delivery_notes">Notes (Optional)</label>
          <textarea id="delivery_notes" name="notes" placeholder="Any discrepancies or additional details..."></textarea>
        </div>

        <div class="modal__actions">
          <button type="button" class="btn-outline" id="cancelConfirmDelivery">Cancel</button>
          <button type="submit" class="btn-success">Confirm Delivery</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>lucide.createIcons();</script>
  <script src="/js/staff-transactions.js"></script>
  <script src="/js/notifications.js"></script>
</body>
</html>
