<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PharmaSeek — Medicine Catalog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/users.css">
  <link rel="stylesheet" href="/css/inventory.css">
</head>
<body>

  <div class="layout">

    <!-- ── SIDEBAR ─────────────────────────────────── -->
    <%- include('../partials/staff-sidebar', { active: 'inventory' }) %>

    <!-- ── MAIN ────────────────────────────────────── -->
    <main class="main">

      <div class="topbar">
        <div>
          <h1>Medicine Catalog</h1>
          <p>Browse the pharmacy's medicine records</p>
        </div>
        <div class="topbar__actions">
          <button class="bell" title="Notifications">
            <i data-lucide="bell" class="ic"></i>
            <span class="dot"></span>
          </button>
        </div>
      </div>

      <hr class="divider">

      <% if (error) { %>
        <div class="alert alert--error">
          <i data-lucide="circle-alert" class="ic"></i>
          <%= error %>
        </div>
      <% } %>

      <!-- ── SEARCH + CATEGORY FILTER ────────────────── -->
      <div class="catalog-toolbar">
        <div class="search">
          <i data-lucide="search" class="ic"></i>
          <input type="text" id="medicineSearch" placeholder="Search by medicine name...">
        </div>
        <select id="categoryFilter">
          <option value="All">All Categories</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c.category_id %>"><%= c.category_name %></option>
          <% }); %>
          <option value="out-of-stock">Out of Stock</option>
          <option value="low-stock">Low Stock</option>
          <option value="expired">Expired</option>
        </select>
      </div>

      <p class="catalog-filter-note" id="catalogFilterNote" style="display:none;">
        <i data-lucide="info" class="ic"></i> <span id="catalogFilterNoteText"></span>
      </p>

      <!-- ── CATALOG ──────────────────────────────────── -->
      <% if (groups.length === 0) { %>
        <p class="empty-catalog">No medicines in the catalog yet.</p>
      <% } else { %>
        <% groups.forEach(function(group) { %>
          <div class="category-group" data-category-group>
            <div class="category-group__header">
              <h2><%= group.name %></h2>
              <span class="count-badge"><%= group.items.length %></span>
            </div>
            <div class="medicine-grid">
              <% group.items.forEach(function(m) { %>
                <% const isLow = m.stock_quantity < m.stock_threshold; %>
                <button type="button" class="medicine-card medicine-item"
                        data-category-id="<%= m.category_id || '' %>"
                        data-name="<%= m.medicine_name.toLowerCase() %>"
                        data-id="<%= m.medicine_id %>"
                        data-medicine-name="<%= m.medicine_name %>"
                        data-brand-name="<%= m.brand_name || '' %>"
                        data-medicine-type="<%= m.medicine_type || '' %>"
                        data-dose="<%= m.dose || '' %>"
                        data-description="<%= m.description || '' %>"
                        data-unit-price="<%= m.unit_price %>"
                        data-stock-quantity="<%= m.stock_quantity %>"
                        data-stock-threshold="<%= m.stock_threshold %>"
                        data-expiration-date="<%= m.expiration_date ? new Date(m.expiration_date).toISOString().slice(0,10) : '' %>"
                        data-category-name="<%= m.category_name || '' %>"
                        data-supplier-name="<%= m.supplier_name || '' %>"
                        data-supplier-phone="<%= m.supplier_phone || '' %>"
                        data-image-path="<%= m.image_path || '' %>"
                        data-status-class="<%= m.statusBadge ? m.statusBadge.cls : '' %>"
                        data-status-label="<%= m.statusBadge ? m.statusBadge.label : '' %>">
                  <div class="medicine-card__image">
                    <% if (m.statusBadge) { %>
                      <span class="medicine-card__badge badge badge--<%= m.statusBadge.cls %>"><%= m.statusBadge.label %></span>
                    <% } %>
                    <% if (m.image_path) { %>
                      <img src="<%= m.image_path %>" alt="<%= m.medicine_name %>">
                    <% } else { %>
                      <i data-lucide="image" class="ic"></i>
                    <% } %>
                  </div>
                  <div class="medicine-card__body">
                    <div class="medicine-card__name"><%= m.medicine_name %></div>
                    <div class="medicine-card__brand"><%= m.brand_name || ' ' %></div>
                    <div class="medicine-card__footer">
                      <div>
                        <div class="medicine-card__stock-label">Stock</div>
                        <div class="medicine-card__stock-value <%= isLow ? 'text-low-stock' : '' %>">
                          <%= Number(m.stock_quantity).toLocaleString() %> units
                        </div>
                      </div>
                      <div class="medicine-card__price">₱<%= Number(m.unit_price).toFixed(2) %></div>
                    </div>
                  </div>
                </button>
              <% }); %>
            </div>
            <hr class="category-group__divider">
          </div>
        <% }); %>
      <% } %>

      <p class="page-footer">
        &copy; <%= new Date().getFullYear() %> PharmaSeek Inventory Management System.
      </p>

    </main>
  </div>

  <!-- ── MEDICINE DETAIL MODAL ─────────────────────── -->
  <div class="modal-overlay detail-modal" id="detailOverlay">
    <div class="modal">
      <div class="detail-image">
        <i data-lucide="image" class="ic" id="detailImageIcon"></i>
        <img id="detailImage" alt="" hidden>
        <button class="modal__close" id="closeDetail" type="button">
          <i data-lucide="x" class="ic"></i>
        </button>
      </div>
      <div class="detail-body">
        <div class="detail-name-row">
          <div class="detail-name" id="detailName"></div>
          <span class="badge" id="detailStatusBadge" hidden></span>
        </div>
        <div class="detail-brand" id="detailBrand"></div>
        <div class="detail-meta" id="detailMeta"></div>
        <p class="detail-desc" id="detailDescription"></p>

        <div class="detail-stats">
          <div class="detail-stats__item">
            <div class="detail-stats__label">Unit Price</div>
            <div class="detail-stats__value" id="detailPrice"></div>
          </div>
          <div class="detail-stats__item">
            <div class="detail-stats__label">Current Stock</div>
            <div class="detail-stats__value" id="detailStock"></div>
          </div>
          <div class="detail-stats__item">
            <div class="detail-stats__label">Stock Threshold</div>
            <div class="detail-stats__value" id="detailThreshold"></div>
          </div>
          <div class="detail-stats__item">
            <div class="detail-stats__label">Expiration Date</div>
            <div class="detail-stats__value" id="detailExpiration"></div>
          </div>
        </div>

        <div class="detail-category">
          <span class="badge badge--category" id="detailCategory"></span>
        </div>

        <div class="detail-supplier" id="detailSupplierBlock">
          <div class="detail-supplier__label">Supplier</div>
          <div class="detail-supplier__name" id="detailSupplierName"></div>
          <div class="detail-supplier__phone" id="detailSupplierPhone"></div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>lucide.createIcons();</script>
  <script src="/js/staff-inventory.js"></script>
  <script src="/js/notifications.js"></script>
</body>
</html>
