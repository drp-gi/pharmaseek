<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PharmaSeek — Pharmacist Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/inventory.css">
</head>
<body>

  <div class="layout">

    <!-- ── SIDEBAR ─────────────────────────────────── -->
    <%- include('../partials/pharmacist-sidebar', { active: 'dashboard' }) %>

    <!-- ── MAIN ────────────────────────────────────── -->
    <main class="main">

      <div class="topbar">
        <div>
          <h1>Dashboard</h1>
          <p>Overview of inventory and restock activity</p>
        </div>
        <div class="topbar__actions">
          <button class="bell" title="Notifications">
            <i data-lucide="bell" class="ic"></i>
            <span class="dot"></span>
          </button>
        </div>
      </div>

      <hr class="divider">

      <% if (error) { %>
        <div class="alert alert--error">
          <i data-lucide="circle-alert" class="ic"></i>
          <%= error %>
        </div>
      <% } %>

      <!-- ── STAT CARDS ─────────────────────────────── -->
      <section class="stats stats--5">
        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--blue"><i data-lucide="briefcase-medical" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Total Medicines</div>
            <div class="stat-card__value"><%= stats.totalMedicines %></div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--amber"><i data-lucide="circle-chevron-down" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Low Stock Items</div>
            <div class="stat-card__value"><%= stats.lowStock %></div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--red"><i data-lucide="calendar-x" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Expired</div>
            <div class="stat-card__value"><%= stats.expired %></div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--amber"><i data-lucide="calendar-clock" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Expiring Soon</div>
            <div class="stat-card__value"><%= stats.expiringSoon %></div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--green"><i data-lucide="arrow-left-right" class="ic"></i></div>
          <div>
            <div class="stat-card__label">Pending Restocks</div>
            <div class="stat-card__value"><%= stats.pendingRestocks %></div>
          </div>
        </div>
      </section>

      <!-- ── LOW STOCK + NEAR EXPIRY ──────────────────── -->
      <section class="bottom-grid">
        <div class="panel">
          <div class="panel__header">
            <h2>Low Stock Alerts</h2>
          </div>

          <div class="table-wrap">
            <table class="tx-table">
              <thead>
                <tr>
                  <th>Medicine</th>
                  <th>Category</th>
                  <th>Current Stock</th>
                  <th>Threshold</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (lowStockItems.length === 0) { %>
                  <tr class="empty-row"><td colspan="5">No medicines are below their stock threshold.</td></tr>
                <% } else { %>
                  <% lowStockItems.forEach(function(m) { %>
                    <% const outOfStock = Number(m.stock_quantity) === 0; %>
                    <tr>
                      <td class="medicine-name"><%= m.medicine_name %></td>
                      <td><%= m.category_name || '—' %></td>
                      <td class="text-low-stock"><%= Number(m.stock_quantity).toLocaleString() %> units</td>
                      <td><%= Number(m.stock_threshold).toLocaleString() %> units</td>
                      <td>
                        <% if (outOfStock) { %>
                          Out of Stock
                        <% } else { %>
                          Low Stock
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>

          <a href="/pharmacist/inventory"><button class="btn-primary btn-primary--below-table">View Full Inventory <i data-lucide="arrow-right" class="ic"></i></button></a>
        </div>

        <div class="panel">
          <div class="panel__header">
            <h2>Near Expiry</h2>
          </div>

          <div class="table-wrap">
            <table class="tx-table">
              <thead>
                <tr>
                  <th>Medicine</th>
                  <th>Category</th>
                  <th>Expiration Date</th>
                  <th>Days Left</th>
                </tr>
              </thead>
              <tbody>
                <% if (nearExpiryItems.length === 0) { %>
                  <tr class="empty-row"><td colspan="4">No medicines are expiring within 30 days.</td></tr>
                <% } else { %>
                  <% nearExpiryItems.forEach(function(m) { %>
                    <tr>
                      <td class="medicine-name"><%= m.medicine_name %></td>
                      <td><%= m.category_name || '—' %></td>
                      <td><%= new Date(m.expiration_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Manila' }) %></td>
                      <td>
                        <%= m.daysLeft %> day<%= m.daysLeft === 1 ? '' : 's' %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>




      
      <!-- ── PENDING RESTOCK REQUESTS ─────────────────── -->
      <% if (stats.pendingRestocks > 0) { %>
        <section class="panel">
          <div class="panel__header">
            <h2>Pending Restock Requests</h2>
          </div>

          <div class="table-wrap">
            <table class="tx-table">
              <thead>
                <tr>
                  <th>Medicine</th>
                  <th>Requested Quantity</th>
                  <th>Request Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% pendingRestockItems.forEach(function(r) { %>
                  <tr>
                    <td class="medicine-name"><%= r.medicine_name %></td>
                    <td><%= Number(r.quantity_requested).toLocaleString() %> units</td>
                    <td><%= new Date(r.request_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Manila' }) %></td>
                    <td>
                      <div class="request-actions">
                        <form action="/pharmacist/restock-requests/<%= r.request_id %>/approve" method="POST">
                          <input type="hidden" name="return_to" value="/pharmacist/dashboard">
                          <button type="submit" class="btn-approve"><i data-lucide="check" class="ic"></i> Approve</button>
                        </form>
                        <% if (Number(r.stock_quantity) === 0) { %>
                          <% const blockedMsg = "Can't dismiss this request — " + r.medicine_name + " is completely out of stock. It will stay open until it's restocked or the medicine is marked as discontinued."; %>
                          <form action="/pharmacist/restock-requests/<%= r.request_id %>/dismiss" method="POST"
                                onsubmit="alert(<%= JSON.stringify(blockedMsg) %>); return false;">
                            <input type="hidden" name="return_to" value="/pharmacist/dashboard">
                            <button type="submit" class="btn-dismiss"><i data-lucide="x" class="ic"></i> Dismiss</button>
                          </form>
                        <% } else { %>
                          <form action="/pharmacist/restock-requests/<%= r.request_id %>/dismiss" method="POST" onsubmit="return confirm('Dismiss this restock request?');">
                            <input type="hidden" name="return_to" value="/pharmacist/dashboard">
                            <button type="submit" class="btn-dismiss"><i data-lucide="x" class="ic"></i> Dismiss</button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>


      
      <!-- ── RECENT TRANSACTIONS ────────────────────── -->
      <section class="panel">
        <div class="panel__header">
          <h2>Recent Transactions</h2>
        </div>

        <div class="table-wrap">
          <table class="tx-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Medicine Name</th>
                <th>Type</th>
                <th>Quantity Added</th>
                <th>Quantity Removed</th>
                <th>Remaining Stock</th>
                <th>Recorded By</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentTransactions.length === 0) { %>
                <tr class="empty-row">
                  <td colspan="7">No transactions recorded yet.</td>
                </tr>
              <% } else { %>
                <% recentTransactions.forEach(function(tx) { %>
                  <% const isRestock = tx.transaction_type === 'restock'; %>
                  <% const initials = tx.first_name[0]; %>
                  <% const colorIndex = (tx.first_name.charCodeAt(0) + tx.last_name.charCodeAt(0)) % 5; %>
                  <tr>
                    <td><%= new Date(tx.transaction_date).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila' }) %></td>
                    <td class="medicine-name"><%= tx.medicine_name %></td>
                    <td>
                      <span class="badge badge--<%= tx.transaction_type %>"><%= tx.transaction_type.toUpperCase() %></span>
                    </td>
                    <td class="qty-pos"><%= isRestock ? tx.transaction_quantity : 0 %></td>
                    <td class="qty-neg"><%= isRestock ? 0 : tx.transaction_quantity %></td>
                    <td><%= tx.stock_quantity %></td>
                    <td>
                      <div class="tx-user">
                        <div class="avatar avatar--<%= colorIndex %>"><%= initials %></div>
                        <%= tx.first_name %> <%= tx.last_name %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>

        <a href="/pharmacist/transactions?tab=history"><button class="btn-primary btn-primary--below-table">View All Transactions <i data-lucide="arrow-right" class="ic"></i></button></a>
      </section>



      <p class="page-footer">
        &copy; <%= new Date().getFullYear() %> PharmaSeek Inventory Management System.
      </p>

    </main>
  </div>

  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>lucide.createIcons();</script>
  <script src="/js/notifications.js"></script>
</body>
</html>
